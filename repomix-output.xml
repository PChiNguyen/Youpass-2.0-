        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
          {filteredTests.map((test) => (
            <TestCard
              key={test.id}
              test={test}
              achievedBand={
                test.id in completedBands ? completedBands[test.id] : null
              }
            />
          ))}
        </div>
      )}
    </div>
  );
}
